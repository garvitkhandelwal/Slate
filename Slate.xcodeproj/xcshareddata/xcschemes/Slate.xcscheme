      <PreActions>
         <ExecutionAction
            ActionType = "Xcode.IDEStandardExecutionActionsCore.ExecutionActionType.ShellScriptAction">
            <ActionContent
               title = "Verify Release Constraints (archive/install only)"
               scriptText = "# Runs the static release audit only for archive/install builds and stamps success for the sandboxed&#10;# &apos;Verify Release Constraints&apos; build phase. Debug incremental builds skip it entirely.&#10;if [ &quot;${ACTION}&quot; = &quot;install&quot; ] || [ &quot;${DEPLOYMENT_POSTPROCESSING}&quot; = &quot;YES&quot; ]; then&#10;  cd &quot;${SRCROOT}&quot; &amp;&amp; mkdir -p build &amp;&amp; rm -f build/release-constraints.stamp &amp;&amp; Scripts/verify-release-constraints.sh &amp;&amp; date &gt; build/release-constraints.stamp&#10;fi&#10;">
               <EnvironmentBuildable>
                  <BuildableReference
                     BuildableIdentifier = "primary"
                     BlueprintIdentifier = "5A1A7E000000000000000030"
                     BuildableName = "Slate.app"
                     BlueprintName = "Slate"
                     ReferencedContainer = "container:Slate.xcodeproj">
                  </BuildableReference>
               </EnvironmentBuildable>
            </ActionContent>
         </ExecutionAction>
      </PreActions>
      <BuildActionEntries>
         <BuildActionEntry
            buildForTesting = "YES"
            buildForRunning = "YES"
            buildForProfiling = "YES"
            buildForArchiving = "YES"
            buildForAnalyzing = "YES">
